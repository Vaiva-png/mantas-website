# -----------------------------------------------------------------------------
# Vorlage für .env  —  DIESE Datei wird eingecheckt, .env NICHT.
#
#   cp .env.example .env
#
# Danach die echten Werte in .env eintragen. Niemals echte Tokens hier hinein.
# -----------------------------------------------------------------------------

# Persönliches Zugriffstoken von Netlify.
# Erzeugen unter: https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_AUTH_TOKEN=

# ID der Netlify-Site (nach dem ersten "netlify link" in .netlify/state.json
# zu finden, oder im Netlify-Dashboard unter Site configuration → Site ID).
NETLIFY_SITE_ID=
